# Neon / Postgres
# Pooled (transaction mode) — use this for all runtime queries from apps and workers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?channel_binding=require&sslmode=verify-full

# Direct (no pooler) — required for migrations and DDL. Session state is preserved here.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# Neon identifiers, for the Neon serverless driver and branch-based tooling
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_REGION=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=http://localhost:3000
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_PRO=
DODO_PRODUCT_SCALE=
DODO_PRODUCT_CREDITS_10K=
DODO_PRODUCT_CREDITS_50K=
DODO_PRODUCT_CREDITS_250K=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Redis / BullMQ
# BullMQ uses Redis TCP, not Upstash REST. Put the Upstash TCP URL from Connect > TCP here.
REDIS_URL=
# Optional alias when using Upstash. Example format: rediss://default:<TCP_PASSWORD>@<HOST>:6379
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SNAPFORGE_LOCAL_CAPTURE=0
CAPTURE_INTENT_ENCRYPTION_KEY=
CAPTURE_INTENT_PREVIOUS_KEYS=

# Queue tuning. Sync timeout is capped at 2000ms by the package; the rest are defaults.
SNAPFORGE_QUEUE_CONCURRENCY=
SNAPFORGE_QUEUE_ATTEMPTS=
SNAPFORGE_SYNC_TIMEOUT_MS=
SNAPFORGE_WEBHOOK_ALLOW_PRIVATE_HOSTS=
